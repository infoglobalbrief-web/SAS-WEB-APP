# ──────────────────────────────────────────────────────────────
# SAS WEB APP — environment configuration
# Copy to `.env` and adjust values. This file is safe to commit
# (contains NO real secrets).
# ──────────────────────────────────────────────────────────────

# --- Database -------------------------------------------------
# DEV default: PGlite — an embedded, pure-WASM PostgreSQL used through the
# pglite-prisma-adapter (see prisma.config.ts). No server needed.
DATABASE_DIR=".data/pglite"

# PRODUCTION: point at a real PostgreSQL server and the app will use
# @prisma/adapter-pg automatically when DATABASE_URL is set (src/lib/prisma.ts).
DATABASE_URL="postgresql://user:password@host:5432/sasweb"

# --- Auth -----------------------------------------------------
# Session token secret. Generate one with:  openssl rand -base64 32
AUTH_SECRET="CHANGE_ME__generate_with_openssl_rand_base64_32"

# --- FAKE OTP provider (DEVELOPMENT ONLY) ---------------------
# 1 = OTPs printed to the server console (default). 0 = real providers.
FAKE_OTP="1"

# --- OTP policy (product plan §9) -----------------------------
OTP_TTL_MINUTES="5"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_COOLDOWN_SECONDS="30"
OTP_MAX_RESENDS_PER_HOUR="5"

# --- Real OTP / messaging providers (when FAKE_OTP=0) ---------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SAS Web App <no-reply@example.com>"
SMS_PROVIDER="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Google OAuth (plan §4 — optional social login) -----------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Billing provider abstraction (plan §26) ------------------
# razorpay | stripe | none  → "none" keeps billing in manual mode
BILLING_PROVIDER="none"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- App ------------------------------------------------------
APP_NAME="SAS Web App"
APP_URL="http://localhost:3000"
